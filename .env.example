# ─────────────────────────────────────────────────────────────────────────────
# docker-compose environment variables — SAFE TEMPLATE (committed to git)
# Copy this file to .env and fill in the real values.
# .env is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: Host=<host>;Database=<db>;Username=<user>;Password=<password>;
DB_CONNECTION_STRING=Host=REPLACE_ME;Database=NetAPI_Dev;Username=REPLACE_ME;Password=REPLACE_ME;

# JWT signing key — must be at least 32 characters
JWT_KEY=REPLACE_WITH_MIN_32_CHAR_SECRET

# JWT token issuer and audience (must match appsettings.json)
JWT_ISSUER=NetAPI
JWT_AUDIENCE=NetAPI.Client
